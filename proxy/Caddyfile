# 서버 위치: ~/services/_proxy/Caddyfile
# 사이트 추가: 아래 형식으로 블록을 추가하고 reload 한다.
#   <서브도메인>.hwiii.com {
#       reverse_proxy <컨테이너 이름>:<포트>
#   }
# reload: docker compose exec -w /etc/caddy caddy caddy reload

# 폰트커피 리뉴얼 시안 (github.com/gyeolhwi/pont-coffee). 검색 노출 차단
pont-coffee.hwiii.com {
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy pont-coffee-web-1:80
}
